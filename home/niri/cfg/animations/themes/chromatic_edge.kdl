animations {

    slowdown 1.0

    window-open {
        duration-ms 600
        curve "cubic-bezier" 0.0 0.0 0.2 1.0

        custom-shader r"
vec4 open_color(vec3 coords_geo, vec3 size_geo) {

    float progress = niri_clamped_progress;
    vec2 uv = coords_geo.xy;
    vec4 oColor = texture2D(niri_tex, coords_geo.st);

    // Circular distance from center, normalized so corners = 1.0
    // Capped at 0.88 so corners are never stuck waiting for the final frame
    vec2 centered = uv * 2.0 - vec2(1.0);
    float m = min(length(centered) / 1.4142135, 0.88);

    // Soft reveal edge
    float mask = 1.0 - smoothstep(progress - 0.02, progress + 0.02, m);

    // Chromatic ring just behind the reveal boundary
    float edge = smoothstep(progress - 0.12, progress - 0.02, m)
               * (1.0 - smoothstep(progress - 0.02, progress + 0.02, m));

    // Fade the ring out as the animation finishes
    edge *= 1.0 - smoothstep(0.7, 1.0, progress);

    vec3 color = cos(uv.xyx + vec3(0.0, 2.0, 4.0) + progress * 3.14);

    return (oColor * mask) + (edge * vec4(color, 1.0));
}
"
    }

    window-close {
        duration-ms 500
        curve "cubic-bezier" 0.2 0.0 1.0 0.0

        custom-shader r"
vec4 close_color(vec3 coords_geo, vec3 size_geo) {

    float progress = 1.0 - niri_clamped_progress;
    vec2 uv = coords_geo.xy;
    vec4 oColor = texture2D(niri_tex, coords_geo.st);

    vec2 centered = uv * 2.0 - vec2(1.0);
    float m = min(length(centered) / 1.4142135, 0.88);

    float mask = 1.0 - smoothstep(progress - 0.02, progress + 0.02, m);

    float edge = smoothstep(progress - 0.12, progress - 0.02, m)
               * (1.0 - smoothstep(progress - 0.02, progress + 0.02, m));

    edge *= 1.0 - smoothstep(0.7, 1.0, progress);

    vec3 color = cos(uv.xyx + vec3(0.0, 2.0, 4.0) - progress * 3.14);

    return (oColor * mask) + (edge * vec4(color, 1.0));
}
"
    }

    window-resize {
        duration-ms 300
        curve "cubic-bezier" 0.0 0.0 0.2 1.0
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=760 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=640 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=820 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=560 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 220
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=620 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=680 epsilon=0.001
    }
}
