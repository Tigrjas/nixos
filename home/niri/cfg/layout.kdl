    layout {
        gaps 12 // Gap between windows
        center-focused-column "on-overflow"
        always-center-single-column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        shadow {
            on
            
        }

        default-column-width { proportion 0.50; }

        preset-column-widths {
            proportion 0.33;
            proportion 0.48;
            proportion 0.66;
        }

        struts {}

        focus-ring {
            width 4
            // This makes a rainbow ring
            active-gradient from="#f00f" to="#0f05" angle=45 in="oklch longer hue"

        }

        

    }
