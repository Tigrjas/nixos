// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "── System ──────────────────────────",
    },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",

    { "type": "break" },

    {
      "type": "custom",
      "format": "── Desktop ─────────────────────────",
    },
    "display",
    "wm",
    "theme",
    "font",
    "cursor",

    { "type": "break" },

    {
      "type": "custom",
      "format": "── Terminal ────────────────────────",
    },
    "terminal",
    "terminalfont",

    { "type": "break" },

    {
      "type": "custom",
      "format": "── Hardware ────────────────────────",
    },
    "cpu",
    "gpu",
    "memory",
    "swap",

    { "type": "break" },

    {
      "type": "custom",
      "format": "── Storage & Network ───────────────",
    },
    "disk",
    "localip",
    "locale",
  ],
}
